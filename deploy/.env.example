# Production environment for docker-compose.prod.yml.
#
# The whole file (minus IMAGE_PREFIX / IMAGE_TAG, which the workflow appends) is
# stored as the `PROD_ENV_FILE` secret on the GitHub `production` environment and
# written to /opt/tellmom/.env on every deploy. Edit the secret, not the file on
# the server: the next rollout overwrites it.

# The public hostname Traefik routes. The site, the dashboard (/app/) and the
# proxy's API all live on it, and the dashboard bundle is built against
# https://<this> (PUBLIC_URL in the workflow must match). DNS must point here
# for Traefik to get a certificate.
SITE_DOMAIN=tellmom.example.com

# Traefik's Docker network, created by the Ansible playbook.
TRAEFIK_NETWORK=traefik

# The proxy's own database: server ids, usernames and bcrypt hashes, nothing
# else. Both values go into a connection URL, so keep them URL-safe
# (letters, digits, - and _): `openssl rand -hex 24`.
POSTGRES_USER=tellmom
POSTGRES_PASSWORD=

# Signs the tokens servers use to hold their tunnel open. `openssl rand -hex 32`.
# Changing it logs every server out; they log back in on their own.
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Requests per visitor per minute to the playground classifier. Traefik applies
# its own limit (2/s, burst 10) in front of this one.
DEMO_RATE_LIMIT=30
